    { "id": "kanc.hotya", "pattern": "несмотря на тот факт,? что", "after": "хотя",
      "why": "«Несмотря на тот факт, что» — канцелярит: «хотя»." },
    { "id": "kanc.poetomu", "pattern": "(?:в связи с этим|в этой связи|в результате этого|по этой причине|с учётом вышеизложенного|с учетом вышеизложенного|учитывая вышеизложенное|исходя из вышесказанного|в силу этого|вследствие этого|в свете вышеизложенного|в соответствии с вышеизложенным)", "after": "поэтому",
      "why": "Канцелярская связка. «Поэтому» — короче и яснее." },
    { "id": "kanc.iz-za", "pattern": "в связи с (\\p{L}+)", "after": "из-за {1:gent}", "cond": "nextIsAblt",
      "why": "«В связи с» — канцелярит: «из-за» или «по». «В связи с праздниками» → «из-за праздников»." },
    { "id": "kanc.iz-za", "pattern": "по причине (\\p{L}+)", "after": "из-за $1",
      "why": "«По причине» — канцелярит: «из-за»." },
    { "id": "kanc.po", "pattern": "в соответствии с (\\p{L}+)", "after": "по {1:datv}", "cond": "nextIsAblt",
