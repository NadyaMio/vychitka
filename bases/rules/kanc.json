    { "id": "kanc.poka", "pattern": "до тех пор,? пока", "after": "пока",
      "why": "«До тех пор пока» — тяжеловесно: достаточно «пока»." },
    { "id": "kanc.chtoby", "pattern": "(?:для того,? чтобы|с тем,? чтобы|ради того,? чтобы)", "after": "чтобы",
